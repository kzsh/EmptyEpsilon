# CMake toolchain file for building EmptyEpsilon for iOS / iOS Simulator.
#
# Relies on CMake's built-in iOS support (requires CMake >= 3.14 and Xcode).
#
# Select the target platform by setting IOS_PLATFORM (default: OS64):
#   -DIOS_PLATFORM=OS64        arm64 device (iPhone/iPad)          [default]
#   -DIOS_PLATFORM=SIMULATOR64 x86_64 simulator (Intel Macs)
#   -DIOS_PLATFORM=SIMULATORARM64 arm64 simulator (Apple Silicon)
#
# Minimum deployment target defaults to 13.0; override with IOS_DEPLOYMENT_TARGET.
#
# Example:
#   cmake .. -G Ninja \
#       -DCMAKE_TOOLCHAIN_FILE=../cmake/ios.toolchain \
#       -DIOS_PLATFORM=OS64 \
#       -DSERIOUS_PROTON_DIR=../SeriousProton

# Guard against multiple inclusion (CMake invokes toolchains several times).
if(DEFINED EE_IOS_TOOLCHAIN_INCLUDED)
    return()
endif()
set(EE_IOS_TOOLCHAIN_INCLUDED TRUE)

set(CMAKE_SYSTEM_NAME iOS)

if(NOT DEFINED IOS_PLATFORM)
    set(IOS_PLATFORM "OS64")
endif()
set(IOS_PLATFORM "${IOS_PLATFORM}" CACHE STRING "iOS target platform (OS64/SIMULATOR64/SIMULATORARM64)")

if(NOT DEFINED IOS_DEPLOYMENT_TARGET)
    set(IOS_DEPLOYMENT_TARGET "13.0")
endif()
set(CMAKE_OSX_DEPLOYMENT_TARGET "${IOS_DEPLOYMENT_TARGET}" CACHE STRING "Minimum iOS deployment version")

if(IOS_PLATFORM STREQUAL "OS64")
    set(CMAKE_OSX_SYSROOT "iphoneos" CACHE STRING "")
    set(CMAKE_OSX_ARCHITECTURES "arm64" CACHE STRING "")
elseif(IOS_PLATFORM STREQUAL "SIMULATOR64")
    set(CMAKE_OSX_SYSROOT "iphonesimulator" CACHE STRING "")
    set(CMAKE_OSX_ARCHITECTURES "x86_64" CACHE STRING "")
elseif(IOS_PLATFORM STREQUAL "SIMULATORARM64")
    set(CMAKE_OSX_SYSROOT "iphonesimulator" CACHE STRING "")
    set(CMAKE_OSX_ARCHITECTURES "arm64" CACHE STRING "")
else()
    message(FATAL_ERROR "Unknown IOS_PLATFORM '${IOS_PLATFORM}'. Use OS64, SIMULATOR64 or SIMULATORARM64.")
endif()

# iOS binaries must be code-signed to run on device. For local/dev builds we let
# Xcode's automatic signing handle it; override these on the command line as needed.
set(CMAKE_XCODE_ATTRIBUTE_CODE_SIGNING_ALLOWED "NO" CACHE STRING "")
set(CMAKE_XCODE_ATTRIBUTE_ONLY_ACTIVE_ARCH "YES" CACHE STRING "")

# Only search the iOS SDK for libraries/headers; host tools remain on the host.
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM BOTH)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY BOTH)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE BOTH)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE BOTH)
